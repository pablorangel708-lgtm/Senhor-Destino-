local portals = { parts = {}, conn = nil, armed = true }

local function closePortals(instant)
	if portals.conn then
		portals.conn:Disconnect()
		portals.conn = nil
	end
	for _, p in ipairs(portals.parts) do
		if p.Parent then
			if instant then
				p:Destroy()
			else
				TweenService:Create(p, TweenInfo.new(0.4), { Size = Vector3.new(p.Size.X, 0.4, 0.4) }):Play()
				Debris:AddItem(p, 0.5)
			end
		end
	end
	portals.parts = {}
	portals.armed = true
	setBtnActive("Portal", false)
end

local function newPortalDisc(center, dir)
	local cf = CFrame.lookAt(center, center + dir) * CFrame.Angles(0, math.pi / 2, 0)
	local function disc(color, transp, finalSize, thick)
		local p = new("Part", {
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(thick, 0.5, 0.5),
			Material = Enum.Material.Neon,
			Color = color,
			Transparency = transp,
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CFrame = cf,
		}, workspace)
		table.insert(portals.parts, p)
		track(p)
		TweenService:Create(
			p,
			TweenInfo.new(0.8, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Size = Vector3.new(thick, finalSize, finalSize) }
		):Play()
		return p
	end
	local rim = disc(GOLD, 0.2, 10.4, 0.2)
	local main = disc(BLUE, 0.35, 9, 0.3)
	for _, face in ipairs({ Enum.NormalId.Right, Enum.NormalId.Left }) do
		local sg = surfaceGui(main, face, 2.5)
		buildArcane(sg, 1.2, 3)
	end
	local a = new("Attachment", {}, main)
	newEmitter(a, { rate = 55, speedMin = 2, speedMax = 7, size = 0.7 })
	new("PointLight", { Color = BLUE_L, Range = 20, Brightness = 3 }, main)
	return main
end

local function onPortalPressed()
	if selecting then
		endSelect()
		return
	end
	local rem = cdRemaining("Portal")
	if rem > 0 then
		toast(string.format("Portais em recarga (%ds)", math.ceil(rem)))
		return
	end
	local char, hum, hrp = getCharacter()
	if not char then
		return
	end
	beginSelect("PORTAIS: toque no destino do portal", function(res)
		local c, h, r = getCharacter()
		if not c then
			return true
		end
		local sPos, msg = standPointFromHit(res.Position, res.Normal, res.Material)
		if not sPos then
			toast(msg)
			return false
		end
		local look = flatDir(r.CFrame.LookVector)
		local entGround = floorBelow(r.Position + look * 8)
		if not entGround then
			toast("Sem chão à frente para abrir o portal.")
			return false
		end
		local arrive = standPointAt(res.Position + look * 7) or standPointAt(res.Position - look * 7) or sPos

		closePortals(true)
		startCd("Portal")
		local origin = r.Position
		local entCenter = entGround + Vector3.new(0, 4.6, 0)
		local exitCenter = res.Position + Vector3.new(0, 4.6, 0)
		newPortalDisc(entCenter, look)
		newPortalDisc(exitCenter, look)
		Effects.PortalPulse(entGround)
		Effects.PortalPulse(res.Position)
		fire("Portal", entGround)
		fire("Portal", res.Position)
		playSound(CONFIG.Sounds.Portal)
		setBtnActive("Portal", true)
		toast("Portal aberto. Atravesse para ir e voltar.")

		portals.armed = true
		portals.conn = track(RunService.Heartbeat:Connect(function()
			local c2, h2, r2 = getCharacter()
			if not c2 or State.busy then
				return
			end
			local dE = (r2.Position - entCenter).Magnitude
			local dX = (r2.Position - exitCenter).Magnitude
			if not portals.armed then
				if dE > 6 and dX > 6 then
					portals.armed = true
				end
				return
			end
			if dE < 3.4 then
				portals.armed = false
				task.spawn(teleportCharacter, arrive, look, true)
			elseif dX < 3.4 then
				portals.armed = false
				task.spawn(teleportCharacter, origin, -look, true)
			end
		end))
		later(CONFIG.PortalLifetime, function()
			closePortals(false)
		end)
		return true
	end)
end

