local function newEmitter(parent, cfg)
	cfg = cfg or {}
	local e = Instance.new("ParticleEmitter")
	e.LightEmission = 1
	e.Color = cfg.color or ColorSequence.new(GOLD, BLUE_L)
	e.Size = NumberSequence.new(cfg.size or 0.7, 0)
	e.Transparency = NumberSequence.new(0, 1)
	e.Rate = cfg.rate or 20
	e.Speed = NumberRange.new(cfg.speedMin or 2, cfg.speedMax or 6)
	e.Lifetime = NumberRange.new(cfg.lifeMin or 0.8, cfg.lifeMax or 1.6)
	e.SpreadAngle = Vector2.new(cfg.spread or 180, cfg.spread or 180)
	e.Acceleration = cfg.accel or Vector3.new(0, 0, 0)
	e.Drag = cfg.drag or 0
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-120, 120)
	e.Enabled = cfg.enabled ~= false
	e.Parent = parent
	return e
end

local function fxPart(pos, life)
	local p = new("Part", {
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Transparency = 1,
		Size = Vector3.new(0.5, 0.5, 0.5),
		CFrame = CFrame.new(pos),
	}, workspace)
	track(p)
	Debris:AddItem(p, life or 4)
	return p
end

local function groundCircle(pos, diameter, life, speedMul)
	local part = new("Part", {
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Transparency = 1,
		Size = Vector3.new(0.1, 0.2, 0.1),
		CFrame = CFrame.new(pos),
	}, workspace)
	track(part)
	local sg = surfaceGui(part, Enum.NormalId.Top, 2.5)
	buildArcane(sg, speedMul or 1, 3)
	new("PointLight", { Color = GOLD, Range = math.clamp(diameter * 0.7, 6, 60), Brightness = 1.5 }, part)
	TweenService:Create(
		part,
		TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ Size = Vector3.new(diameter, 0.2, diameter) }
	):Play()
	if life then
		later(life, function()
			if part.Parent then
				local tw = TweenService:Create(
					part,
					TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
					{ Size = Vector3.new(0.1, 0.2, 0.1) }
				)
				tw:Play()
				tw.Completed:Connect(function()
					part:Destroy()
				end)
			end
		end)
		Debris:AddItem(part, life + 2)
	end
	return part
end

local function ball(pos, startSize, endSize, color, dur, startTransp)
	local b = new("Part", {
		Shape = Enum.PartType.Ball,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Material = Enum.Material.Neon,
		Color = color,
		Transparency = startTransp or 0.1,
		Size = Vector3.new(startSize, startSize, startSize),
		CFrame = CFrame.new(pos),
	}, workspace)
	track(b)
	Debris:AddItem(b, dur + 0.3)
	TweenService:Create(
		b,
		TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.new(endSize, endSize, endSize), Transparency = 1 }
	):Play()
	return b
end

local function shake(dur, mag)
	local sid = session.id
	local t0 = os.clock()
	task.spawn(function()
		local _, h = getCharacter()
		while h and h.Parent and os.clock() - t0 < dur and session.id == sid do
			local k = 1 - (os.clock() - t0) / dur
			h.CameraOffset = Vector3.new((math.random() - 0.5) * mag * k, (math.random() - 0.5) * mag * k, 0)
			RunService.RenderStepped:Wait()
		end
		if h and h.Parent then
			h.CameraOffset = Vector3.new(0, 0, 0)
		end
	end)
end

Effects = {}

function Effects.ShockRing(pos, maxD, dur, color, thick)
	local part = new("Part", {
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Transparency = 1,
		Size = Vector3.new(1, 0.2, 1),
		CFrame = CFrame.new(pos),
	}, workspace)
	track(part)
	Debris:AddItem(part, dur + 0.3)
	local sg = surfaceGui(part, Enum.NormalId.Top, 3)
	local ring = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, sg)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, ring)
	local st = new("UIStroke", { Color = color or GOLD, Thickness = thick or 16, Transparency = 0 }, ring)
	TweenService:Create(
		part,
		TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.new(maxD, 0.2, maxD) }
	):Play()
	TweenService:Create(st, TweenInfo.new(dur, Enum.EasingStyle.Linear), { Transparency = 1 }):Play()
end

function Effects.Burst(pos, goldCount, blueCount, speed)
	local p = fxPart(pos, 4)
	local a = new("Attachment", {}, p)
	local e1 = newEmitter(a, {
		enabled = false,
		color = ColorSequence.new(GOLD_L, GOLD),
		speedMin = speed * 0.4,
		speedMax = speed,
		size = 0.9,
		lifeMin = 0.6,
		lifeMax = 1.4,
	})
	local e2 = newEmitter(a, {
		enabled = false,
		color = ColorSequence.new(BLUE_L, BLUE),
		speedMin = speed * 0.3,
		speedMax = speed * 0.9,
		size = 0.8,
		lifeMin = 0.6,
		lifeMax = 1.4,
	})
	e1:Emit(goldCount)
	e2:Emit(blueCount)
	local light = new("PointLight", { Color = GOLD_L, Range = 24, Brightness = 5 }, p)
	TweenService:Create(light, TweenInfo.new(0.8), { Brightness = 0 }):Play()
end

function Effects.TeleportBurst(pos)
	Effects.Burst(pos, 55, 40, 22)
	Effects.ShockRing(pos, 14, 0.6, GOLD, 12)
	local floor = floorBelow(pos)
	if floor then
		groundCircle(floor + Vector3.new(0, 0.12, 0), 10, 1.2, 2)
	end
end

function Effects.PortalPulse(pos)
	Effects.Burst(pos, 40, 40, 16)
	Effects.ShockRing(pos, 16, 0.8, BLUE_L, 12)
	local floor = floorBelow(pos) or pos
	groundCircle(floor + Vector3.new(0, 0.12, 0), 13, 1.8, 1.5)
end

function Effects.HelmPulse(char, putOn)
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end
	local pos = hrp.Position
	local hl = new("Highlight", {
		FillColor = GOLD,
		OutlineColor = BLUE_L,
		FillTransparency = 0.1,
		OutlineTransparency = 0,
		DepthMode = Enum.HighlightDepthMode.Occluded,
		Adornee = char,
	}, char)
	track(hl)
	TweenService:Create(hl, TweenInfo.new(1.8), { FillTransparency = 1, OutlineTransparency = 1 }):Play()
	Debris:AddItem(hl, 2.2)

	local floor = floorBelow(pos) or (pos - Vector3.new(0, 3, 0))
	for i = 0, 2 do
		task.delay(i * 0.2, function()
			Effects.ShockRing(floor + Vector3.new(0, 0.2, 0), 20 + i * 8, 0.9, (i % 2 == 0) and GOLD or BLUE_L, 10)
		end)
	end
	if putOn then
		groundCircle(floor + Vector3.new(0, 0.12, 0), 18, 3, 1.5)
	end

	local a = new("Attachment", {}, hrp)
	track(a)
	local spiral = newEmitter(a, {
		rate = 120,
		speedMin = 4,
		speedMax = 9,
		spread = 25,
		accel = Vector3.new(0, 4, 0),
		size = 0.8,
		lifeMin = 0.8,
		lifeMax = 1.5,
	})
	spiral.EmissionDirection = Enum.NormalId.Top
	task.delay(1.6, function()
		spiral.Enabled = false
	end)
	Debris:AddItem(a, 4)
	Effects.Burst(pos, 70, 50, 26)
end

function Effects.Telepathy(char, targetChar, text)
	local head = char and char:FindFirstChild("Head")
	if not head then
		return
	end
	local bb = new("BillboardGui", {
		Adornee = head,
		Size = UDim2.fromOffset(240, 64),
		StudsOffsetWorldSpace = Vector3.new(0, 3.4, 0),
		AlwaysOnTop = true,
		MaxDistance = 150,
	}, head)
	track(bb)
	local lbl = new("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		TextColor3 = GOLD_L,
		Font = Enum.Font.GothamMedium,
		TextScaled = true,
		TextWrapped = true,
		Text = text,
	}, bb)
	new("UITextSizeConstraint", { MaxTextSize = 18, MinTextSize = 8 }, lbl)
	local st = new("UIStroke", { Color = BLUE, Thickness = 2 }, lbl)
	task.delay(4, function()
		if lbl.Parent then
			TweenService:Create(lbl, TweenInfo.new(1), { TextTransparency = 1 }):Play()
			TweenService:Create(st, TweenInfo.new(1), { Transparency = 1 }):Play()
		end
	end)
	Debris:AddItem(bb, 5.5)

	local hrp = char:FindFirstChild("HumanoidRootPart")
	local thrp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
	if hrp then
		Effects.Burst(hrp.Position + Vector3.new(0, 3, 0), 25, 25, 10)
		if thrp then
			local a0 = new("Attachment", {}, hrp)
			local a1 = new("Attachment", {}, thrp)
			track(a0)
			track(a1)
			local beam = new("Beam", {
				Attachment0 = a0,
				Attachment1 = a1,
				Color = ColorSequence.new(GOLD, BLUE_L),
				LightEmission = 1,
				Width0 = 0.35,
				Width1 = 0.35,
				CurveSize0 = 4,
				CurveSize1 = -4,
				FaceCamera = true,
				Segments = 24,
				Transparency = NumberSequence.new(0.15),
			}, hrp)
			track(beam)
			Debris:AddItem(beam, 2.5)
			Debris:AddItem(a0, 2.6)
			Debris:AddItem(a1, 2.6)
		end
	end
end

function Effects.Explosion(pos)
	ball(pos + Vector3.new(0, 2, 0), 2, 40, Color3.new(1, 1, 1), 0.5, 0.05)
	ball(pos + Vector3.new(0, 2, 0), 2, 58, GOLD, 0.85, 0.15)
	ball(pos + Vector3.new(0, 2, 0), 2, 36, BLUE_L, 0.7, 0.35)

	for i = 0, 2 do
		task.delay(i * 0.18, function()
			Effects.ShockRing(
				pos + Vector3.new(0, 0.3, 0),
				95 + i * 15,
				1 + i * 0.2,
				(i % 2 == 0) and GOLD or BLUE_L,
				20
			)
		end)
	end

	-- pilar de luz
	local pillar = new("Part", {
		Shape = Enum.PartType.Cylinder,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Material = Enum.Material.Neon,
		Color = BLUE_L,
		Transparency = 0.3,
		Size = Vector3.new(140, 8, 8),
		CFrame = CFrame.new(pos + Vector3.new(0, 70, 0)) * CFrame.Angles(0, 0, math.pi / 2),
	}, workspace)
	track(pillar)
	Debris:AddItem(pillar, 1.6)
	TweenService:Create(
		pillar,
		TweenInfo.new(1.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.new(140, 0.5, 0.5), Transparency = 1 }
	):Play()

	Effects.Burst(pos + Vector3.new(0, 2, 0), 180, 120, 70)
	local p = fxPart(pos + Vector3.new(0, 4, 0), 3)
	local light = new("PointLight", { Color = GOLD_L, Range = 70, Brightness = 8 }, p)
	TweenService:Create(light, TweenInfo.new(1.6), { Brightness = 0 }):Play()
	groundCircle(pos + Vector3.new(0, 0.15, 0), 44, 3.5, 1.5)

	local cc = new("ColorCorrectionEffect", { Brightness = 0.35, Contrast = 0.2, TintColor = GOLD_L }, Lighting)
	track(cc)
	TweenService:Create(cc, TweenInfo.new(0.9), { Brightness = 0, Contrast = 0, TintColor = Color3.new(1, 1, 1) }):Play()
	Debris:AddItem(cc, 1.2)

	local _, _, hrp = getCharacter()
	if hrp and (hrp.Position - pos).Magnitude < 110 then
		shake(0.7, 1.4)
	end
end

local function onRemote(userId, kind, pos)
	if typeof(kind) ~= "string" or typeof(pos) ~= "Vector3" then
		return
	end
	local sender = Players:GetPlayerByUserId(userId)
	if kind == "HelmOn" or kind == "HelmOff" then
		if sender and sender.Character then
			Effects.HelmPulse(sender.Character, kind == "HelmOn")
		end
	elseif kind == "Teleport" then
		Effects.TeleportBurst(pos)
	elseif kind == "Portal" then
		Effects.PortalPulse(pos)
	elseif kind == "Supreme" then
		Effects.Explosion(pos)
	end
end

task.spawn(function()
	local ev = ReplicatedStorage:WaitForChild("LordFateEvent", 8)
	if ev and ev:IsA("RemoteEvent") then
		remote = ev
		ev.OnClientEvent:Connect(onRemote)
	end
end)

