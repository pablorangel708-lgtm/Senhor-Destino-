local function buildHelmet(char)
	if not CONFIG.ShowHelmet then
		return
	end
	local head = char:FindFirstChild("Head")
	if not head then
		return
	end
	local d = math.max(head.Size.Y, head.Size.Z) * 1.4
	local r = d / 2

	local function addPart(props, offset)
		props.CanCollide = false
		props.CanQuery = false
		props.CanTouch = false
		props.Massless = true
		props.Anchored = false
		props.CFrame = head.CFrame * offset
		local p = new("Part", props, char)
		new("WeldConstraint", { Part0 = head, Part1 = p }, p)
		track(p)
		return p
	end

	local dome = addPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(d, d, d),
		Color = GOLD_D,
		Material = Enum.Material.Metal,
		Transparency = 0.12,
		Name = "ElmoDeNabu",
	}, CFrame.new(0, 0.05, 0))
	new("PointLight", { Color = BLUE_L, Range = 8, Brightness = 1 }, dome)

	addPart({
		Size = Vector3.new(d * 0.09, d * 0.5, d * 0.55),
		Color = GOLD,
		Material = Enum.Material.Metal,
		Name = "CristaElmo",
	}, CFrame.new(0, r * 0.95, 0))

	for _, sx in ipairs({ -1, 1 }) do
		addPart({
			Size = Vector3.new(d * 0.17, d * 0.06, d * 0.06),
			Color = BLUE_L,
			Material = Enum.Material.Neon,
			Name = "OlhoElmo",
