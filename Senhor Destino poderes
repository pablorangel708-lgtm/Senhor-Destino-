	if char and char:FindFirstChild("HumanoidRootPart") then
		State.persistFx = true
		pcall(Effects.HelmPulse, char, false)
		State.persistFx = false
		fire("HelmOff", char.HumanoidRootPart.Position)
	end

	stopFlight()
	stopTime(true)
	closePortals(true)
	endSelect()
	setTelepathyOpen(false)
	State.panelOpen = true -- força o fechamento animado
	setPanelOpen(false)
	showFloat(false)
	State.casting = false
	State.busy = false
	restoreCharacter()
	cleanupSession()
end

local function activate()
	if State.active or activating then
		return
	end
	local char, hum, hrp = getCharacter()
	if not char then
		return
	end
	activating = true
	cleanupSession()
	State.active = true

	track(hum.Died:Connect(function()
		deactivate()
	end))
	track(player.CharacterRemoving:Connect(function()
		deactivate()
	end))

	buildHelmet(char)
	Effects.HelmPulse(char, true)
	fire("HelmOn", hrp.Position)
	playSound(CONFIG.Sounds.Activate)

	showFloat(true)
	task.delay(0.6, function()
		if State.active then
			setPanelOpen(true)
			toast("Elmo de Nabu ativado.")
		end
	end)
	activating = false
end

local function handleChat(message)
	local msg = string.lower(message:match("^%s*(.-)%s*$") or "")
	if msg == CONFIG.ActivateCommand then
		activate()
	elseif msg == CONFIG.DeactivateCommand then
		deactivate()
	end
end

player.Chatted:Connect(handleChat)

