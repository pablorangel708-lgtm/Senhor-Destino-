		local pos, msg = standPointFromHit(res.Position, res.Normal, res.Material)
		if not pos then
			toast(msg)
			return false
		end
		startCd("Teleport")
		task.spawn(teleportCharacter, pos, nil, false)
		return true
	end)
end

