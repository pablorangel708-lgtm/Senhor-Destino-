	end
end

local function restoreCharacter()
	local char = player.Character
	if not char then
		return
	end
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") then
			pcall(function()
				d.LocalTransparencyModifier = 0
			end)
		end
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.CameraOffset = Vector3.new(0, 0, 0)
	end
	local cam = getCamera()
	if cam and State.origFOV then
		cam.FieldOfView = State.origFOV
		State.origFOV = nil
	end
end

local function fadeCharacter(char, to, dur)
	local parts = {}
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(parts, { d, d.LocalTransparencyModifier })
		end
	end
	local t0 = os.clock()
	local a = 0
	repeat
		a = math.clamp((os.clock() - t0) / dur, 0, 1)
		for _, e in ipairs(parts) do
			if e[1].Parent then
				e[1].LocalTransparencyModifier = e[2] + (to - e[2]) * a
			end
		end
		RunService.Heartbeat:Wait()
	until a >= 1
end

