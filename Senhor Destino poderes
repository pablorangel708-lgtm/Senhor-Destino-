local function pickAt(screenPos)
	if not selecting then
		return
	end
	local cam = getCamera()
	local ray = cam:ScreenPointToRay(screenPos.X, screenPos.Y)
	local res = workspace:Raycast(ray.Origin, ray.Direction * 2000, rayParams())
	if not res then
		toast("Nada para selecionar nesse ponto.")
		return
	end
	local accepted = selecting.onPick(res)
	if accepted then
		endSelect()
	end
end

UserInputService.InputBegan:Connect(function(input, gp)
	if gp or not selecting then
		return
	end
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		tapStart = { input = input, pos = input.Position, t = os.clock() }
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if tapStart and tapStart.input == input then
		local ts = tapStart
		tapStart = nil
		if selecting and (input.Position - ts.pos).Magnitude < 14 and os.clock() - ts.t < 0.6 then
			pickAt(input.Position)
		end
	end
end)

