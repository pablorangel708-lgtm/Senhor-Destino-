local timeState = { mode = 0, cc = nil, bloom = nil, circle = nil, conn = nil, emitterAtt = nil }
local TIME_LABELS = { [0] = "TEMPO: NORMAL", [1] = "TEMPO: LENTO", [2] = "TEMPO: CONGELADO" }

local function setOthersSpeed(factor)
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl ~= player and pl.Character then
			local hum = pl.Character:FindFirstChildOfClass("Humanoid")
			local animator = hum and hum:FindFirstChildOfClass("Animator")
			if animator then
				for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
					pcall(function()
						tr:AdjustSpeed(factor)
					end)
				end
			end
		end
	end
end

local function stopTime(quiet)
	if timeState.mode == 0 and not timeState.conn then
		return
	end
	timeState.mode = 0
	if timeState.conn then
		timeState.conn:Disconnect()
		timeState.conn = nil
	end
	setOthersSpeed(1)
	for _, k in ipairs({ "cc", "bloom", "circle", "emitterAtt" }) do
		local o = timeState[k]
		if o and o.Parent then
			if quiet then
				o:Destroy()
			elseif k == "cc" then
				TweenService:Create(o, TweenInfo.new(0.6), { Saturation = 0, Contrast = 0, TintColor = Color3.new(1, 1, 1) }):Play()
				Debris:AddItem(o, 0.7)
			elseif k == "bloom" then
				TweenService:Create(o, TweenInfo.new(0.6), { Intensity = 0 }):Play()
				Debris:AddItem(o, 0.7)
			elseif k == "circle" then
				TweenService:Create(o, TweenInfo.new(0.5), { Size = Vector3.new(0.1, 0.2, 0.1) }):Play()
				Debris:AddItem(o, 0.6)
			else
				o:Destroy()
			end
		end
		timeState[k] = nil
	end
	setBtnActive("Time", false)
	setBtnText("Time", buttons.Time.base)
end

local function applyTimeMode(mode)
	local char, hum, hrp = getCharacter()
	if not char then
		return
	end
	local firstTime = timeState.mode == 0
	timeState.mode = mode

	if not timeState.cc then
		timeState.cc = track(new("ColorCorrectionEffect", {}, Lighting))
		timeState.bloom = track(new("BloomEffect", { Intensity = 0, Size = 24, Threshold = 0.9 }, Lighting))
	end
	local slow = mode == 1
	TweenService:Create(timeState.cc, TweenInfo.new(0.6), {
		Saturation = slow and -0.35 or -0.8,
		Contrast = slow and 0.1 or 0.25,
		TintColor = slow and Color3.fromRGB(255, 235, 190) or Color3.fromRGB(190, 215, 255),
	}):Play()
	TweenService:Create(timeState.bloom, TweenInfo.new(0.6), { Intensity = slow and 0.6 or 1.2 }):Play()

	if firstTime then
		local floor = floorBelow(hrp.Position) or (hrp.Position - Vector3.new(0, 3, 0))
		timeState.circle = groundCircle(floor + Vector3.new(0, 0.12, 0), 15, nil, 1.5)
		local a = track(new("Attachment", {}, hrp))
		timeState.emitterAtt = a
		newEmitter(a, {
			rate = 14,
			speedMin = 0.3,
			speedMax = 1,
			lifeMin = 2,
			lifeMax = 3.5,
			size = 0.5,
			accel = Vector3.new(0, 0.6, 0),
			color = ColorSequence.new(GOLD_L, BLUE_L),
		})
		local acc = 0
		timeState.conn = track(RunService.Heartbeat:Connect(function(dt)
			local c, h, r = getCharacter()
			if not c then
				return
			end
			if timeState.circle and timeState.circle.Parent then
				local fl = floorBelow(r.Position)
				if fl then
					timeState.circle.CFrame = CFrame.new(fl + Vector3.new(0, 0.12, 0))
				end
			end
			acc += dt
			if acc >= 0.12 then
				acc = 0
				setOthersSpeed(timeState.mode == 1 and 0.25 or 0)
			end
		end))
	end
	Effects.ShockRing(hrp.Position - Vector3.new(0, 2.8, 0), 30, 0.8, slow and GOLD or BLUE_L, 12)
	setBtnActive("Time", true)
	setBtnText("Time", TIME_LABELS[mode])
end

local function onTimePressed()
	local rem = cdRemaining("Time")
	if rem > 0 then
		return
	end
	startCd("Time")
	local char, _, hrp = getCharacter()
	if not char then
		return
	end
	if timeState.mode == 0 then
		applyTimeMode(1)
		toast("Tempo desacelerado (efeito visual local).")
	elseif timeState.mode == 1 then
		applyTimeMode(2)
		toast("Tempo congelado (efeito visual local).")
	else
		Effects.ShockRing(hrp.Position - Vector3.new(0, 2.8, 0), 40, 0.9, GOLD, 14)
		Effects.Burst(hrp.Position, 60, 40, 30)
		stopTime(false)
		toast("O tempo foi retomado.")
	end
end

