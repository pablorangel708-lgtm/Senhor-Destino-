local function standPointFromHit(hitPos, normal, material)
	local char, hum, hrp = getCharacter()
	if not char then
		return nil, "Personagem indisponível."
	end
	if material == Enum.Material.Water then
		return nil, "Não dá para ir para a água."
	end
	if normal.Y < 0.55 then
		return nil, "Superfície inclinada demais."
	end
	if (hitPos - hrp.Position).Magnitude > CONFIG.MaxTeleportDistance then
		return nil, "Destino distante demais."
	end
	local bbCF, bbSize = char:GetBoundingBox()
	local footToRoot = hrp.Position.Y - (bbCF.Position.Y - bbSize.Y / 2)
	local target = hitPos + Vector3.new(0, footToRoot + 0.15, 0)
	local centerOffset = bbCF.Position - hrp.Position
	local boxCF = CFrame.new(target + centerOffset + Vector3.new(0, 0.4, 0))
	local boxSize = Vector3.new(2.6, math.max(bbSize.Y - 0.8, 2), 2.6)
	local op = OverlapParams.new()
	op.FilterType = Enum.RaycastFilterType.Exclude
	op.FilterDescendantsInstances = allCharacters()
	for _, part in ipairs(workspace:GetPartBoundsInBox(boxCF, boxSize, op)) do
		if part.CanCollide then
			return nil, "Espaço bloqueado nesse destino."
		end
	end
	return target
end

local function standPointAt(pos)
	local r = workspace:Raycast(pos + Vector3.new(0, 25, 0), Vector3.new(0, -80, 0), rayParams())
	if not r then
		return nil, "Sem chão no destino."
	end
	return standPointFromHit(r.Position, r.Normal, r.Material)
end

local function teleportCharacter(pos, face, fast)
	local char, hum, hrp = getCharacter()
	if not char or State.busy then
		return false
	end
	local sid = session.id
	State.busy = true
	local dur = fast and 0.18 or 0.35
	local from = hrp.Position
	Effects.TeleportBurst(from)
	fire("Teleport", from)
	playSound(CONFIG.Sounds.Teleport)
	fadeCharacter(char, 1, dur)
	if session.id ~= sid then
		State.busy = false
		return false
	end
	char, hum, hrp = getCharacter()
	if not char then
		State.busy = false
		return false
	end
	local look = flatDir(face or hrp.CFrame.LookVector)
	hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
	char:PivotTo(CFrame.lookAt(pos, pos + look))
	Effects.TeleportBurst(pos)
	fire("Teleport", pos)
	fadeCharacter(char, 0, dur)
	State.busy = false
	return true
end

