-- PODER 6: MAGIA SUPREMA (visual, sem dano)
--------------------------------------------------------------------------------
local function getHands(char)
	local out = {}
	for _, n in ipairs({ "LeftHand", "RightHand", "Left Arm", "Right Arm" }) do
		local p = char:FindFirstChild(n)
		if p then
			table.insert(out, p)
		end
	end
	return out
end

local function castSupreme(targetPos)
	local char, hum, hrp = getCharacter()
	if not char or State.casting then
		return
	end
	State.casting = true
	startCd("Supreme")
	local sid = session.id
	local cam = getCamera()
	playSound(CONFIG.Sounds.Supreme)

	local ground = floorBelow(hrp.Position) or (hrp.Position - Vector3.new(0, 3, 0))
	groundCircle(ground + Vector3.new(0, 0.12, 0), 34, 4.2, 2)

	local orb = new("Part", {
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.5, 0.5, 0.5),
		Material = Enum.Material.Neon,
		Color = GOLD,
		Transparency = 0.1,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CFrame = hrp.CFrame + Vector3.new(0, 4.5, 0),
	}, workspace)
	track(orb)
	local orbLight = new("PointLight", { Color = GOLD, Range = 8, Brightness = 2 }, orb)
	newEmitter(orb, { rate = 60, speedMin = 1, speedMax = 4, size = 0.9 })

	local handEmitters = {}
	for _, h in ipairs(getHands(char)) do
		local a = track(new("Attachment", {}, h))
		table.insert(handEmitters, newEmitter(a, { rate = 45, speedMin = 1, speedMax = 3, size = 0.6 }))
	end

	local origFOV = cam.FieldOfView
	State.origFOV = origFOV
	TweenService:Create(cam, TweenInfo.new(2.6, Enum.EasingStyle.Quad), { FieldOfView = origFOV - 10 }):Play()

	local dur = 2.6
	local t0 = os.clock()
	while true do
		local a = (os.clock() - t0) / dur
		if a >= 1 then
			break
		end
		if session.id ~= sid then
			return
		end
		local c, h, r = getCharacter()
		if not c then
			State.casting = false
			return
		end
		orb.Position = r.Position + Vector3.new(0, 4.5 + math.sin(os.clock() * 6) * 0.25, 0)
		local s = 0.5 + 4.5 * a
		orb.Size = Vector3.new(s, s, s)
		orb.Color = GOLD:Lerp(BLUE_L, (math.sin(os.clock() * 8) + 1) / 2)
		orbLight.Range = 8 + 22 * a
		RunService.Heartbeat:Wait()
	end

	for _, e in ipairs(handEmitters) do
		e.Enabled = false
	end
	local tw = TweenService:Create(
		orb,
		TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ Position = targetPos + Vector3.new(0, 2, 0), Size = Vector3.new(3, 3, 3) }
	)
	tw:Play()
	tw.Completed:Wait()
	if session.id ~= sid then
		return
	end
	orb:Destroy()
	Effects.Explosion(targetPos)
	fire("Supreme", targetPos)
	TweenService:Create(cam, TweenInfo.new(0.7), { FieldOfView = origFOV }):Play()
	later(0.8, function()
		State.origFOV = nil
	end)
	State.casting = false
end

local function onSupremePressed()
	if selecting then
		endSelect()
		return
	end
	if State.casting then
		return
	end
	local rem = cdRemaining("Supreme")
	if rem > 0 then
		toast(string.format("Magia Suprema em recarga (%ds)", math.ceil(rem)))
		return
	end
	local char, hum, hrp = getCharacter()
	if not char then
		return
	end
	beginSelect("MAGIA SUPREMA: toque no alvo", function(res)
		if (res.Position - hrp.Position).Magnitude > CONFIG.SupremeMaxRange then
			toast("Alvo longe demais.")
			return false
		end
		task.spawn(castSupreme, res.Position)
		return true
	end, function()
		local c, h, r = getCharacter()
		if not c then
			return
		end
		local aheadPos = r.Position + flatDir(r.CFrame.LookVector) * CONFIG.SupremeAheadDistance
		task.spawn(castSupreme, floorBelow(aheadPos) or (aheadPos - Vector3.new(0, 3, 0)))
	end)
end

