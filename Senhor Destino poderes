local flight = { conns = {}, objs = {}, saved = nil }

local function stopFlight()
	if not State.flying then
		return
	end
	State.flying = false
	for _, c in ipairs(flight.conns) do
		pcall(function()
			c:Disconnect()
		end)
	end
	for _, o in ipairs(flight.objs) do
		pcall(function()
			o:Destroy()
		end)
	end
	flight.conns, flight.objs = {}, {}
	local _, hum = getCharacter()
	if hum and flight.saved then
		hum.PlatformStand = flight.saved.platformStand
		hum.AutoRotate = flight.saved.autoRotate
	end
	flight.saved = nil
	flyInput.up, flyInput.down = false, false
	flyPad.Visible = false
	setBtnActive("Fly", false)
	setBtnText("Fly", buttons.Fly.base)
end

local function startFlight()
	local char, hum, hrp = getCharacter()
	if not char or State.flying then
		return
	end
	State.flying = true
	flight.saved = { platformStand = hum.PlatformStand, autoRotate = hum.AutoRotate }
	hum.PlatformStand = true
	hum.AutoRotate = false

	local function mk(class, props, parent)
		local o = new(class, props, parent)
		table.insert(flight.objs, o)
		return o
	end

	local att = mk("Attachment", {}, hrp)
	local lv = mk("LinearVelocity", {
		Attachment0 = att,
		MaxForce = math.huge,
		VelocityConstraintMode = Enum.VelocityConstraintMode.Vector,
		VectorVelocity = Vector3.new(0, 0, 0),
		RelativeTo = Enum.ActuatorRelativeTo.World,
	}, hrp)
	local ao = mk("AlignOrientation", {
		Mode = Enum.OrientationAlignmentMode.OneAttachment,
		Attachment0 = att,
		RigidityEnabled = false,
		MaxTorque = math.huge,
		MaxAngularVelocity = math.huge,
		Responsiveness = 25,
		CFrame = hrp.CFrame.Rotation,
	}, hrp)

	-- aura dourada e azul
	mk("Highlight", {
		FillColor = GOLD,
		OutlineColor = BLUE_L,
		FillTransparency = 0.85,
		OutlineTransparency = 0.2,
		DepthMode = Enum.HighlightDepthMode.Occluded,
		Adornee = char,
	}, char)
	local auraAtt = mk("Attachment", {}, hrp)
	newEmitter(auraAtt, { rate = 35, color = ColorSequence.new(GOLD, GOLD_L), speedMin = 1, speedMax = 3, size = 0.8 })
	newEmitter(auraAtt, { rate = 25, color = ColorSequence.new(BLUE_L, BLUE), speedMin = 1, speedMax = 3, size = 0.7 })
	mk("PointLight", { Color = GOLD, Range = 16, Brightness = 1.5 }, hrp)

	local current = Vector3.new(0, 0, 0)
	local facing = flatDir(hrp.CFrame.LookVector)

	table.insert(flight.conns, RunService.Heartbeat:Connect(function(dt)
		local c, h, r = getCharacter()
		if not c then
			stopFlight()
			return
		end
		local cam = getCamera()
		local mv = h.MoveDirection
		local up = (flyInput.up and 1 or 0) - (flyInput.down and 1 or 0)
		local target = mv * CONFIG.FlySpeed + Vector3.new(0, up * CONFIG.VerticalSpeed, 0)
		if CONFIG.FlyFollowsCameraPitch and mv.Magnitude > 0.1 then
			local look = cam.CFrame.LookVector
			local fwd = mv:Dot(flatDir(look))
			if fwd > 0.3 then
				target += Vector3.new(0, look.Y * CONFIG.FlySpeed * fwd, 0)
			end
		end
		current = current:Lerp(target, 1 - math.exp(-8 * dt))
		lv.VectorVelocity = current
		if mv.Magnitude > 0.1 then
			facing = flatDir(mv, facing)
		end
		local tilt = math.rad(28) * math.min(mv.Magnitude, 1)
		ao.CFrame = CFrame.lookAt(Vector3.new(0, 0, 0), facing) * CFrame.Angles(-tilt, 0, 0)
	end))

	table.insert(flight.conns, UserInputService.InputBegan:Connect(function(input, gp)
		if gp then
			return
		end
		if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.E then
			flyInput.up = true
		elseif input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.LeftControl then
			flyInput.down = true
		end
	end))
	table.insert(flight.conns, UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.E then
			flyInput.up = false
		elseif input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.LeftControl then
			flyInput.down = false
		end
	end))

	flyPad.Visible = true
	setBtnActive("Fly", true)
	setBtnText("Fly", "VOO: ATIVO")
	Effects.Burst(hrp.Position, 40, 30, 18)
end

local function onFlyPressed()
	if State.flying then
		stopFlight()
		toast("Voo desativado.")
	else
		startFlight()
		toast("Voo ativo. Use o direcional + SUBIR/DESCER.")
	end
end

