--------------------------------------------------------------------------------
-- ESTADO E SESSÃO (tudo que é criado ao ativar o Elmo é rastreado e limpo)
--------------------------------------------------------------------------------
local State = {
	active = false,
	panelOpen = false,
	flying = false,
	casting = false,
	busy = false,
	persistFx = false,
	origFOV = nil,
}

local session = { id = 0, conns = {}, insts = {} }

local function track(x)
	if typeof(x) == "RBXScriptConnection" then
		table.insert(session.conns, x)
	elseif typeof(x) == "Instance" then
		if State.persistFx then
			return x
		end
		table.insert(session.insts, x)
		if #session.insts % 150 == 0 then
			local kept = {}
			for _, i in ipairs(session.insts) do
				if i.Parent ~= nil then
					table.insert(kept, i)
				end
			end
			session.insts = kept
		end
	end
	return x
end

local function cleanupSession()
	for _, c in ipairs(session.conns) do
		pcall(function()
			c:Disconnect()
		end)
	end
	for _, i in ipairs(session.insts) do
		pcall(function()
			i:Destroy()
		end)
	end
	session.conns, session.insts = {}, {}
	session.id += 1
end

local function later(t, fn)
	local sid = session.id
	task.delay(t, function()
		if session.id == sid then
			fn()
		end
	end)
end

--------------------------------------------------------------------------------
-- UTILIDADES
--------------------------------------------------------------------------------
local function new(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do
		inst[k] = v
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function corner(parent, r)
	return new("UICorner", { CornerRadius = UDim.new(0, r) }, parent)
end

local function stroke(parent, color, thickness, transparency)
	return new("UIStroke", {
		Color = color,
		Thickness = thickness,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

local function getCamera()
	return workspace.CurrentCamera
end

local function getCharacter()
	local char = player.Character
	if not char then
		return nil
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp or hum.Health <= 0 then
		return nil
	end
	return char, hum, hrp
end

local function allCharacters()
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	return list
end

local function rayParams()
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = allCharacters()
	return rp
end

local function floorBelow(pos)
	local r = workspace:Raycast(pos + Vector3.new(0, 2, 0), Vector3.new(0, -60, 0), rayParams())
	return r and r.Position or nil
end

local function playSound(id)
	if not id or id == "" then
		return
	end
	local _, _, hrp = getCharacter()
	if not hrp then
		return
	end
	local s = new("Sound", { SoundId = id, Volume = 0.6 }, hrp)
	s:Play()
	Debris:AddItem(s, 8)
end

local function flatDir(v, fallback)
	local f = Vector3.new(v.X, 0, v.Z)
	if f.Magnitude < 0.01 then
		return fallback or Vector3.new(0, 0, -1)
	end
	return f.Unit
end

