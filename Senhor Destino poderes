-- PODER 3: TELEPATIA (mensagem de RP, enviada no chat)
--------------------------------------------------------------------------------
local recipIndex = 0

local function otherPlayers()
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			table.insert(list, p)
		end
	end
	return list
end

local function currentRecipient()
	local list = otherPlayers()
	if recipIndex > #list then
		recipIndex = 0
	end
	return list[recipIndex]
end

local function refreshRecipLabel()
	local r = currentRecipient()
	recipBtn.Text = "Destinatário: " .. (r and r.DisplayName or "Todos")
end

local function sendChat(text)
	local sent = false
	pcall(function()
		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
			local ch = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
			if ch then
				ch:SendAsync(text)
				sent = true
			end
		end
	end)
	if sent then
		return true
	end
	pcall(function()
		local ev = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
		local say = ev and ev:FindFirstChild("SayMessageRequest")
		if say then
			say:FireServer(text, "All")
			sent = true
		end
	end)
	return sent
end

local function setTelepathyOpen(open)
	if open then
		refreshRecipLabel()
		teleFrame.GroupTransparency = 1
		teleFrame.Visible = true
		TweenService:Create(teleFrame, TweenInfo.new(0.3), { GroupTransparency = 0 }):Play()
	else
		teleBox:ReleaseFocus()
		teleFrame.Visible = false
	end
end

recipBtn.Activated:Connect(function()
	local n = #otherPlayers()
	recipIndex = (recipIndex + 1) % (n + 1)
	refreshRecipLabel()
end)
teleClose.Activated:Connect(function()
	setTelepathyOpen(false)
end)
sendBtn.Activated:Connect(function()
	if not State.active then
		return
	end
	local rem = cdRemaining("Telepathy")
	if rem > 0 then
		toast("Aguarde um instante.")
		return
	end
	local text = teleBox.Text:match("^%s*(.-)%s*$")
	if text == "" then
		toast("Escreva uma mensagem primeiro.")
		return
	end
	local len = utf8.len(text)
	if len and len > 150 then
		text = text:sub(1, utf8.offset(text, 151) - 1)
	end
	local char = getCharacter()
	if not char then
		return
	end
	local recipient = currentRecipient()
	local prefix = recipient and ("[Telepatia ➜ " .. recipient.DisplayName .. "] ") or "[Telepatia] "
	startCd("Telepathy")
	sendChat(prefix .. text)
	Effects.Telepathy(char, recipient and recipient.Character or nil, text)
	teleBox.Text = ""
	teleBox:ReleaseFocus()
	toast("Mensagem mental enviada.")
end)

local function onTelepathyPressed()
	setTelepathyOpen(not teleFrame.Visible)
end

