local spinners = {}

RunService.RenderStepped:Connect(function(dt)
	for i = #spinners, 1, -1 do
		local s = spinners[i]
		if not s.frame:IsDescendantOf(game) then
			table.remove(spinners, i)
		else
			s.frame.Rotation = (s.frame.Rotation + s.speed * dt) % 360
		end
	end
end)

local function addRing(parent, size, thickness, color, transp)
	local f = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(size, size),
		BackgroundTransparency = 1,
	}, parent)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, f)
	stroke(f, color, thickness, transp)
	return f
end

local function addSquare(parent, size, rot, thickness, color)
	local f = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(size, size),
		Rotation = rot,
		BackgroundTransparency = 1,
	}, parent)
	stroke(f, color, thickness, 0)
	return f
end

local function layer(parent)
	return new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
	}, parent)
end

local function buildArcane(parent, speedMul, thickMul)
	speedMul = speedMul or 1
	thickMul = thickMul or 1
	local root = layer(parent)
	addRing(root, 0.98, 4 * thickMul, GOLD)
	addRing(root, 0.9, 2 * thickMul, GOLD_L, 0.2)

	local spinA = layer(root)
	for i = 1, 12 do
		local a = math.rad(i * 30)
		new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5 + math.cos(a) * 0.42, 0.5 + math.sin(a) * 0.42),
			Size = UDim2.fromScale(0.055, 0.055),
			Rotation = 45,
			BorderSizePixel = 0,
			BackgroundColor3 = (i % 2 == 0) and GOLD or BLUE_L,
		}, spinA)
	end
	addRing(spinA, 0.8, 2 * thickMul, BLUE_L)

	local spinB = layer(root)
	addSquare(spinB, 0.6, 0, 3 * thickMul, GOLD)
	addSquare(spinB, 0.6, 45, 3 * thickMul, GOLD)
	addRing(spinB, 0.62, 2 * thickMul, BLUE_L)

	local spinC = layer(root)
	addRing(spinC, 0.3, 3 * thickMul, GOLD)
	addSquare(spinC, 0.2, 45, 3 * thickMul, BLUE_L)

	table.insert(spinners, { frame = spinA, speed = 25 * speedMul })
	table.insert(spinners, { frame = spinB, speed = -40 * speedMul })
	table.insert(spinners, { frame = spinC, speed = 70 * speedMul })
	return root
end

local function surfaceGui(part, face, brightness)
	return new("SurfaceGui", {
		Face = face,
		SizingMode = Enum.SurfaceGuiSizingMode.FixedSize,
		CanvasSize = Vector2.new(512, 512),
		LightInfluence = 0,
		Brightness = brightness or 2,
	}, part)
end

